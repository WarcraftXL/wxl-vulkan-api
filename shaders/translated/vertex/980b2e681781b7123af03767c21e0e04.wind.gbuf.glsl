    r0.y = dot(r2.xyz, v3.xyz);
    r2 = v1.yyyy * regs.v[33 + a0.y];
    r2 = regs.v[33 + a0.x] * v1.xxxx + r2;
    r2 = regs.v[33 + a0.z] * v1.zzzz + r2;
    r2 = regs.v[33 + a0.w] * v1.wwww + r2;
    r1.z = dot(r2, v0);
    r0.z = dot(r2.xyz, v3.xyz);
    r2.xyz = dx_nrm(r0).xyz;
    r1.w = c0.y;
    o0.x = dot(regs.v[2], r1);
    o0.y = dot(regs.v[3], r1);
    o0.z = dot(regs.v[4], r1);
    o0.w = dot(regs.v[5], r1);
    wxlN = r2.xyz;   // the view-space normal (3.Tools/gbuffer)
    wxlLit = 1.0;
    r0.x = clamp(dot(-regs.v[12].xyz, r2.xyz), 0.0, 1.0);
    o5.xyz = r2.xyz;
    r2.xyz = regs.v[10].xyz;
    r0.xyz = clamp(r0.xxx * r2.xyz + regs.v[11].xyz, 0.0, 1.0);
    wxlL = r0.xyz;   // the light-only term (3.Tools/gbuffer)
    r0.w = c0.y;
    r2 = regs.v[28];
    o1 = clamp(r2 * r0 + regs.v[29], 0.0, 1.0);
    r0.x = r1.z * regs.v[30].x + regs.v[30].y;
    r0.x = max(r0.x, c0.z);
    r2.x = dx_pow(r0.x, regs.v[30].z);
    o9.x = min(r2.x, c0.y);
    o2.x = dot(regs.v[6], r1);
    o2.y = dot(regs.v[7], r1);
    o3.x = dot(regs.v[8], r1);
    o3.y = dot(regs.v[9], r1);
    o6.x = dot(r1, regs.v[224]);
    o6.y = dot(r1, regs.v[225]);
    o6.z = dot(r1, regs.v[226]);
    o7.x = dot(r1, regs.v[227]);
    o7.y = dot(r1, regs.v[228]);
    o7.z = dot(r1, regs.v[229]);
    o8.x = dot(r1, regs.v[230]);
    o8.y = dot(r1, regs.v[231]);
    o8.z = dot(r1, regs.v[232]);
    o6.w = dot(r1, regs.v[233]);
    o7.w = dot(r1, regs.v[234]);
    o8.w = dot(r1, regs.v[235]);
    o4.xyz = r1.xyz;

    // D3D clip space has +y up, Vulkan +y down (no VK_KHR_maintenance1 on 1.0);
    // z is already in [0, 1]: ProjNative on the D3D API id maps it there.
    // The G-buffer varyings (3.Tools/gbuffer): the view-space normal; the material class, flat (one per
    // triangle); how far color0 is from the light-only term, interpolated, so that the pixel half
    // decides "plain" per pixel (see families.py).
    wxlGBuf   = vec4(wxlN, 0.0);
    wxlGClass = 4.0;
    wxlGPlain = (wxlLit > 0.5 ? max(max(abs(o1.xyz * 1.0 - wxlL).x, abs(o1.xyz * 1.0 - wxlL).y), abs(o1.xyz * 1.0 - wxlL).z) : 1.0);
    gl_Position = vec4(o0.x, -o0.y, o0.z, o0.w);
    color0 = o1;
    texcoord0 = o2;
    texcoord1 = o3;
    texcoord2 = o4;
    texcoord3 = o5;
    texcoord4 = o6;
    texcoord5 = o7;
    texcoord6 = o8;
    fog0 = o9.x;
}
