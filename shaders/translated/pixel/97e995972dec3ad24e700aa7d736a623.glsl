#version 450
// The fixed-function pixel stage for the vs_2_0 records drawn with no pixel shader
// (render state 78 null): fixed_fog.
// Generated by the offline translator; do not edit. No bytecode stands behind this
// module: it is what the D3D backend does after such a vertex shader (cgxdevice 6.1, 6.5,
// 6.8), ff.frag re-expressed in the translated interface so it pairs with the translated
// vertex module instead of ff.vert. The DLL binds it when the draw's vertex row carries a
// `companion` line and the draw's pixel shader name is "".
//
//   CURRENT = color0 (the vertex shader's oD0, clamped as the fixed-function interpolator is);
//   stage 0 samples s0 at texcoord0.xy (the vertex shader's oT0);
//   the texel combines with CURRENT by the EGxTexOp in misc.z (colour) / misc.w (alpha),
//   the table ff.frag has (0 Mod, 1 Mod2x, 2 Add, 3 PassThru, 4 Decal, 5 Fade; 6 = stage 0
//   has no texture, the cascade ends), saturated as D3D saturates each stage;
//   render state 7: discard when misc.x > 0 and a < misc.x;
//   fog: oFog is the fog FACTOR with a programmable vertex shader (FOGVERTEXMODE is
//   ignored), blended as f * rgb + (1 - f) * fogColor only while D3DRS_FOGENABLE is on.
//   The colour and the enable come from regs.p[15] = (fogColor.rgb / 255, fogOn ? 1 : 0),
//   a row no shipped pixel record reads, written by the DLL after the pixel-cache copy.

// Varyings read, by semantic, at the locations the translated vertex modules write them.
layout(location = 0) in vec4 color0;
layout(location = 2) in vec4 texcoord0;
layout(location = 10) in float fog0;

layout(location = 0) out vec4 oC0;

// Texture stage 0 (D3D sampler slot 0 = texture stage 0), set 0 binding 0.
layout(set = 0, binding = 0) uniform sampler2D s0;

// The same slice as every translated module (p[] and misc first, v[] last).
layout(std140, set = 1, binding = 0) uniform Regs {
    vec4 p[16];     // pixel c0..c15; p[15] = (fogColor.rgb, fogOn) for this module
    vec4 misc;       // .x alphaRef / 255 (0 = test off), .z stage-0 colour op, .w stage-0 alpha op
    vec4 v[64];     // vertex c0..c63 (not read here)
} regs;

// One EGxTexOp on all four channels, as ff.frag has it; the caller keeps rgb from the colour
// op and a from the alpha op. CURRENT alpha and DIFFUSE alpha are the same value at stage 0.
vec4 ff_op(int op, vec4 t, vec4 cur)
{
    float a = cur.a;
    if (op == 0) return t * cur;
    if (op == 1) return 2.0 * t * cur;
    if (op == 2) return t + cur;
    if (op == 3) return cur;
    if (op == 4) return cur * a + t * (1.0 - a);
    if (op == 5) return t * a + cur * (1.0 - a);
    return cur;
}

void main()
{
    vec4 cur = clamp(color0, 0.0, 1.0);
    vec2 uv = texcoord0.xy;
    int cop = int(regs.misc.z + 0.5);
    int aop = int(regs.misc.w + 0.5);
    if (cop <= 5)
    {
        vec4 t = texture(s0, uv);
        cur = clamp(vec4(ff_op(cop, t, cur).rgb, ff_op(aop, t, cur).a), 0.0, 1.0);
    }

    // Render state 7 (alpha test), the same discard as every translated pixel module.
    if (regs.misc.x > 0.0 && cur.a < regs.misc.x) discard;

    // The fixed-function fog blend, on rgb only, with the vertex shader's oFog as the factor
    // (clamped as the hardware clamps the fog register) while fog is on.
    if (regs.p[15].w > 0.0) cur.rgb = mix(regs.p[15].rgb, cur.rgb, clamp(fog0, 0.0, 1.0));

    oC0 = cur;
}
