            r3 = r5 + -v4.zzzz;
            r3 = mix(c1.xxxx, c1.yyyy, greaterThanEqual(r3, vec4(0.0)));
            r1.y = r9.x + -v4.z;
            r1.y = (r1.y >= 0.0 ? c1.y : c1.x);
            r1.z = dot(r2, c1.yyyy);
            r1.w = dot(r3, c1.yyyy);
            r1.z = r1.z + r1.w;
            r1.y = r1.y + r1.z;
            r1.y = r1.y * c13.z + c13.y;
            r1.x = r0.w * r1.y + c1.y;
        }
    } else {
        r1.x = c1.y;
    }
    r0.w = dot(v2.xyz, regs.p[3].xyz);
    r0.w = clamp(r0.w + regs.p[3].w, 0.0, 1.0);
    r2.x = mix(r1.x, c1.y, r0.w);
    r0.w = max(abs(v5.x), abs(v5.y));
    if (r0.w < c1.y) {
        r1.xy = v5.xy * c1.ww + c1.ww;
        r3.xy = r1.xy + regs.p[5].xy;
        r4.xy = r1.xy + regs.p[7].xy;
        r5.xy = r1.xy + regs.p[9].xy;
        r1.xy = r1.xy + regs.p[11].xy;
        r6 = v5.xyxx * c1.wwxx + c1.wwxx;
        r6 = textureLod(s5, r6.xy, r6.w);
        r3.zw = c0.xx;
        r3 = textureLod(s5, r3.xy, r3.w);
        r4.zw = c0.xx;
        r4 = textureLod(s5, r4.xy, r4.w);
        r5.zw = c0.xx;
        r5 = textureLod(s5, r5.xy, r5.w);
        r1.zw = c0.xx;
        r1 = textureLod(s5, r1.xy, r1.w);
        r6.y = r3.x;
        r6.z = r4.x;
        r6.w = r5.x;
        r3 = r6 + -v5.zzzz;
        r3 = mix(c1.xxxx, c1.yyyy, greaterThanEqual(r3, vec4(0.0)));
        r0.w = r1.x + -v5.z;
        r0.w = (r0.w >= 0.0 ? c1.y : c1.x);
        r1.x = dot(r3, c1.yyyy);
        r0.w = r0.w + r1.x;
        r0.w = r0.w * c13.x;
    } else {
        r1.x = max(abs(v6.x), abs(v6.y));
        if (r1.x < c1.y) {
            r1.xy = v6.xy * c1.ww + c1.ww;
            r3.xy = r1.xy + regs.p[5].xy;
            r4.xy = r1.xy + regs.p[7].xy;
            r5.xy = r1.xy + regs.p[9].xy;
            r1.xy = r1.xy + regs.p[11].xy;
            r6 = v6.xyxx * c1.wwxx + c1.wwxx;
            r6 = textureLod(s6, r6.xy, r6.w);
            r3.zw = c0.xx;
            r3 = textureLod(s6, r3.xy, r3.w);
            r4.zw = c0.xx;
            r4 = textureLod(s6, r4.xy, r4.w);
            r5.zw = c0.xx;
            r5 = textureLod(s6, r5.xy, r5.w);
            r1.zw = c0.xx;
            r1 = textureLod(s6, r1.xy, r1.w);
            r6.y = r3.x;
            r6.z = r4.x;
            r6.w = r5.x;
            r3 = r6 + -v6.zzzz;
            r3 = mix(c1.xxxx, c1.yyyy, greaterThanEqual(r3, vec4(0.0)));
            r1.x = r1.x + -v6.z;
            r1.x = (r1.x >= 0.0 ? c1.y : c1.x);
            r1.y = dot(r3, c1.yyyy);
            r1.x = r1.x + r1.y;
            r0.w = r1.x * c13.x;
        } else {
            r1.x = v4.w * c1.w + c1.w;
            r1.y = v5.w * c1.w + c1.w;
            r3.xy = r1.xy + regs.p[5].xy;
            r4.xy = r1.xy + regs.p[7].xy;
            r5.xy = r1.xy + regs.p[9].xy;
            r6.xy = r1.xy + regs.p[11].xy;
            r1.zw = c0.xx;
            r1 = textureLod(s7, r1.xy, r1.w);
            r3.zw = c0.xx;
            r3 = textureLod(s7, r3.xy, r3.w);
            r4.zw = c0.xx;
            r4 = textureLod(s7, r4.xy, r4.w);
            r5.zw = c0.xx;
            r5 = textureLod(s7, r5.xy, r5.w);
            r6.zw = c0.xx;
            r6 = textureLod(s7, r6.xy, r6.w);
            r1.y = r3.x;
            r1.z = r4.x;
            r1.w = r5.x;
            r1 = r1 + -v6.wwww;
            r1 = mix(c1.xxxx, c1.yyyy, greaterThanEqual(r1, vec4(0.0)));
            r2.y = r6.x + -v6.w;
            r2.y = (r2.y >= 0.0 ? c1.y : c1.x);
            r1.x = dot(r1, c1.yyyy);
            r1.x = r2.y + r1.x;
            r1.y = v4.w;
            r1.z = v5.w;
            r2.y = max(abs(r1.y), abs(r1.z));
            r1.y = clamp(r2.y * c14.x + c14.y, 0.0, 1.0);
