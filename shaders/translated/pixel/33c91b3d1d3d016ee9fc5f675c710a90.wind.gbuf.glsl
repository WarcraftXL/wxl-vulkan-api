        r3 = textureLod(s5, r3.xy, r3.w);
        r2.yz = v6.xy * c14.zz + c14.zz;
        r4.xy = r2.yz + regs.p[5].xy;
        r4.zw = c14.yx * v6.zx;
        r4 = textureLod(s5, r4.xy, r4.w);
        r0.w = r3.x + r4.x;
        r3.xy = r2.yz + regs.p[7].xy;
        r3.zw = c14.yx * v6.zx;
        r3 = textureLod(s5, r3.xy, r3.w);
        r0.w = r0.w + r3.x;
        r3.xy = r2.yz + regs.p[9].xy;
        r3.zw = c14.yx * v6.zx;
        r3 = textureLod(s5, r3.xy, r3.w);
        r0.w = r0.w + r3.x;
        r3.xy = r2.yz + regs.p[11].xy;
        r3.zw = c14.yx * v6.zx;
        r3 = textureLod(s5, r3.xy, r3.w);
        r0.w = r0.w + r3.x;
        r0.w = r0.w * -c14.w;
    } else {
        r1.w = max(abs(v7.x), abs(v7.y));
        if (r1.w < c14.y) {
            r3 = v7.xyzx * c14.zzyx + c14.zzxx;
            r3 = textureLod(s6, r3.xy, r3.w);
            r2.yz = v7.xy * c14.zz + c14.zz;
            r4.xy = r2.yz + regs.p[5].xy;
            r4.zw = c14.yx * v7.zx;
            r4 = textureLod(s6, r4.xy, r4.w);
            r1.w = r3.x + r4.x;
            r3.xy = r2.yz + regs.p[7].xy;
            r3.zw = c14.yx * v7.zx;
            r3 = textureLod(s6, r3.xy, r3.w);
            r1.w = r1.w + r3.x;
            r3.xy = r2.yz + regs.p[9].xy;
            r3.zw = c14.yx * v7.zx;
            r3 = textureLod(s6, r3.xy, r3.w);
            r1.w = r1.w + r3.x;
            r3.xy = r2.yz + regs.p[11].xy;
            r3.zw = c14.yx * v7.zx;
            r3 = textureLod(s6, r3.xy, r3.w);
            r1.w = r1.w + r3.x;
            r0.w = r1.w * -c14.w;
        } else {
            r3.xw = v5.ww * c14.zx + c14.zx;
            r3.y = v6.w * c14.z + c14.z;
            r3.z = v7.w;
            r4 = textureLod(s7, r3.xy, r3.w);
            r5.xy = r3.xy + regs.p[5].xy;
            r5.zw = r3.zw;
            r6 = textureLod(s7, r5.xy, r5.w);
            r1.w = r4.x + r6.x;
            r5.xy = r3.xy + regs.p[7].xy;
            r4 = textureLod(s7, r5.xy, r5.w);
            r1.w = r1.w + r4.x;
            r5.xy = r3.xy + regs.p[9].xy;
            r4 = textureLod(s7, r5.xy, r5.w);
            r1.w = r1.w + r4.x;
            r5.xy = r3.xy + regs.p[11].xy;
            r3 = textureLod(s7, r5.xy, r5.w);
            r1.w = r1.w + r3.x;
            r2.y = v5.w;
            r2.z = v6.w;
            r3.x = max(abs(r2.y), abs(r2.z));
            r2.y = clamp(r3.x * c1.z + c1.w, 0.0, 1.0);
            r1.w = r1.w * -c14.w + -c14.y;
            r0.w = r2.y * r1.w + c14.y;
        }
    }
    r1.w = min(r0.w, r2.x);
    r0.w = dot(regs.p[4].xyz, v4.xyz);
    r0.w = -abs(r0.w) + c13.x;
    r0.w = r0.w * r0.w;
    r0.w = clamp(r0.w * r0.w, 0.0, 1.0);
    r2.x = mix(r1.w, c14.y, r0.w);
    r0.w = r2.x * c13.y + c13.z;
    r2.xyz = r0.www * v0.xyz;
    r0.xyz = r0.xyz * r2.xyz + r1.xyz;
    r0.xyz = r0.xyz + -regs.p[2].xyz;
    oC0.xyz = v8.xxx * r0.xyz + regs.p[2].xyz;

    if (wxlReal) oC0.rgb *= WindCanopyShade();   // light, not albedo (the G-buffer generator)
    return oC0;
}

void main()
{
    float wxlMcsh = 1.0, wxlUnused = 1.0;
    // The G-buffer (wxl-vulkan-api VkRenderApi.h, WXL_VkGBuffer): the textures alone, the normal, the light term.
    // Evaluated first: every texture read of every evaluation happens before any discard, so the quad's
    // derivatives (the mip, the leaf uv) stay defined.
    vec3 wxlBase = WxlBody(vec4(1.0, 1.0, 1.0, color0.a), vec4(0.0), 1.0, 0.0, wxlUnused).rgb;
    vec3 wxlDark = WxlBody(vec4(0.0, 0.0, 0.0, color0.a), vec4(0.0), 1.0, 0.0, wxlUnused).rgb;
    wxlReal = true;
    oC0 = WxlBody(color0, color1, fog0, 1.0, wxlMcsh);
    if (wxlKill) discard;
    // Render state 7 (alpha test) is not in the bytecode: the same discard as
    // combiners_mod.frag, from misc.x = alphaRef / 255 (0 when the test is off).
    if (regs.misc.x > 0.0 && oC0.a < regs.misc.x) discard;

    float wxlFlags = clamp(round(wxlGClass), 0.0, 31.0) + (regs.p[14].y > 0.5 ? 32.0 : 0.0) + (regs.p[14].x > 0.5 ? 64.0 : 0.0) + (wxlGPlain < 0.004 ? 128.0 : 0.0);
    vec3  wxlN     = wxlGBuf.xyz;
    float wxlNn    = dot(wxlN, wxlN);
    wxlAlbedo = vec4(max(wxlBase - wxlDark, vec3(0.0)), wxlFlags / 255.0);
    // The depth tag (wxl-vulkan-api VkRenderApi.h, WXL_VK_GBUFFER_TAG_*): this surface's clip w, log2 scaled, in the
    // normal's w (negative without a normal), so a consumer can tell this record from one a later draw that wrote
    // depth but no G-buffer left under its own pixels.
    float wxlTag   = 0.505 + 0.49 * clamp((log2(max(1.0 / gl_FragCoord.w, 0.0625)) + 4.0) * 0.0625, 0.0, 1.0);
    wxlNormal = wxlNn > 1e-8 ? vec4(wxlN * inversesqrt(wxlNn), wxlTag) : vec4(0.0, 0.0, 0.0, -wxlTag);
    wxlLight  = vec4(color0.rgb * 1.0, wxlMcsh);
}
